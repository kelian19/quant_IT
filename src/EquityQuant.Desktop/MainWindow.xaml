<Window x:Class="EquityQuant.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="quant_IT — Pricing" Height="600" Width="700"><ScrollViewer><StackPanel Margin="30"><TextBlock FontSize="28" Text="Equity Quant Workbench"/><TextBlock Margin="0,10" Text="Démonstration synthétique · Option européenne · API locale"/><CheckBox Content="Call (décocher pour Put)" IsChecked="{Binding IsCall}"/><TextBlock Text="Spot"/><TextBox Text="{Binding Spot}"/><TextBlock Text="Strike"/><TextBox Text="{Binding Strike}"/><TextBlock Text="Maturité (années)"/><TextBox Text="{Binding Years}"/><TextBlock Text="Volatilité (%)"/><TextBox Text="{Binding Volatility}"/><TextBlock Text="Taux (%)"/><TextBox Text="{Binding Rate}"/><TextBlock Text="Dividende (%)"/><TextBox Text="{Binding Dividend}"/><Button Margin="0,15" Padding="10" Content="Valoriser" Command="{Binding Calculate}"/><Button Content="Annuler" Command="{Binding Cancel}"/><TextBlock Margin="0,15" Text="{Binding Output}" TextWrapping="Wrap"/><TextBlock Text="Vega et rho par point de pourcentage ; theta par jour. API : http://127.0.0.1:5080" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Window>